# System Monitor - Realtime Dashboard (TEMPLATE)
# Do not copy manually — run ./install-service.sh instead so that
# User= and WorkingDirectory= are auto-filled for the current user & path.
# See the README "systemd" section.
[Unit]
Description=System Monitor - Realtime Dashboard
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/system-monitor
ExecStart=/usr/bin/python3 /path/to/system-monitor/app.py --host 0.0.0.0 --port 9090
Restart=always
RestartSec=5
Environment=PORT=9090

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=system-monitor

[Install]
WantedBy=multi-user.target
