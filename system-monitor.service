# System Monitor - Realtime Dashboard (TEMPLATE)
# Jangan copy manual — jalankan ./install-service.sh agar
# User= dan WorkingDirectory= terisi otomatis sesuai user & path saat ini.
# Lihat README bagian "systemd".
[Unit]
Description=System Monitor - Realtime Dashboard
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/system-monitor
ExecStart=/usr/bin/python3 /path/to/system-monitor/app.py --host 0.0.0.0 --port 9090
Restart=always
RestartSec=5
Environment=PORT=9090

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=system-monitor

[Install]
WantedBy=multi-user.target
